# ==============================================================================
# SYSDENT PRO - CONFIGURATION DE L'ENVIRONNEMENT
# ==============================================================================

# Application
APP_NAME="SysDent Pro API"
APP_ENV="development" # development, staging, production
DEBUG=true
PORT=8000
HOST="0.0.0.0"
API_V1_PREFIX="/api/v1"

# Sécurité & JWT
SECRET_KEY="CHANGE_THIS_IN_PRODUCTION_SUPER_SECRET_KEY_MINIMUM_32_CHARACTERS"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
# Clé Fernet pour chiffrer les secrets en base (TenantDB.db_password). Générer avec :
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TENANT_DB_ENCRYPTION_KEY="CHANGE_THIS_GENERATE_A_FERNET_KEY_IN_PRODUCTION="

# Base de Données MASTER (Centrale)
MASTER_DB_HOST="localhost"
MASTER_DB_PORT=5432
MASTER_DB_USER="postgres"
MASTER_DB_PASSWORD="postgres_password"
MASTER_DB_NAME="sysdent_master"
MASTER_DB_ECHO=false
MASTER_DB_POOL_SIZE=10
MASTER_DB_MAX_OVERFLOW=20

# Configuration Générique des Bases de Données TENANTS
TENANT_DB_HOST="localhost"
TENANT_DB_PORT=5432
TENANT_DB_USER="postgres"
TENANT_DB_PASSWORD="postgres_password"
TENANT_DB_POOL_SIZE=5
TENANT_DB_MAX_OVERFLOW=10

# Redis (Sessions, Blacklist, Caching, Background Tasks)
REDIS_HOST="localhost"
REDIS_PORT=6379
REDIS_PASSWORD=""
REDIS_DB=0

# CORS & Domaines Autorisés
CORS_ORIGINS=["http://localhost:3000", "http://localhost:5173", "http://127.0.0.1:3000"]
ALLOWED_HOSTS=["*"]

# Logging
LOG_LEVEL="INFO" # DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_JSON_FORMAT=false # true en production pour ELK / Grafana Loki

# ------------------------------------------------------------------------------
# Compte Super Administrateur de la plateforme (console Master)
# ------------------------------------------------------------------------------
# Utilisé par `python init_db.py` pour créer le premier compte Super Admin.
# OBLIGATOIRE si APP_ENV=production : le script refuse de démarrer sans.
# Générer un mot de passe solide, ex :
#   python -c "import secrets; print(secrets.token_urlsafe(24))"
SUPER_ADMIN_EMAIL="admin@sysdent.pro"
SUPER_ADMIN_PASSWORD="CHANGE_THIS_GENERATE_A_STRONG_PASSWORD"
