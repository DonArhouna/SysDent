# ==============================================================================
# SYSDENT PRO - CONFIGURATION DE L'ENVIRONNEMENT
# ==============================================================================

# Application
APP_NAME="SysDent Pro API"
APP_ENV="development" # development, staging, production
DEBUG=true
PORT=8000
HOST="0.0.0.0"
API_V1_PREFIX="/api/v1"

# Sécurité & JWT
SECRET_KEY="CHANGE_THIS_IN_PRODUCTION_SUPER_SECRET_KEY_MINIMUM_32_CHARACTERS"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
# Clé Fernet pour chiffrer les secrets en base (TenantDB.db_password). Générer avec :
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TENANT_DB_ENCRYPTION_KEY="CHANGE_THIS_GENERATE_A_FERNET_KEY_IN_PRODUCTION="

# Base de Données MASTER (Centrale)
MASTER_DB_HOST="localhost"
MASTER_DB_PORT=5432
MASTER_DB_USER="postgres"
MASTER_DB_PASSWORD="postgres_password"
MASTER_DB_NAME="sysdent_master"
MASTER_DB_ECHO=false
MASTER_DB_POOL_SIZE=10
MASTER_DB_MAX_OVERFLOW=20

# Configuration Générique des Bases de Données TENANTS
TENANT_DB_HOST="localhost"
TENANT_DB_PORT=5432
TENANT_DB_USER="postgres"
TENANT_DB_PASSWORD="postgres_password"
TENANT_DB_POOL_SIZE=5
TENANT_DB_MAX_OVERFLOW=10

# Redis (Sessions, Blacklist, Caching, Background Tasks)
REDIS_HOST="localhost"
REDIS_PORT=6379
REDIS_PASSWORD=""
REDIS_DB=0

# CORS & Domaines Autorisés
CORS_ORIGINS=["http://localhost:3000", "http://localhost:5173", "http://127.0.0.1:3000"]
ALLOWED_HOSTS=["*"]

# Logging
LOG_LEVEL="INFO" # DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_JSON_FORMAT=false # true en production pour ELK / Grafana Loki

# ------------------------------------------------------------------------------
# Compte Super Administrateur de la plateforme (console Master)
# ------------------------------------------------------------------------------
# Utilisé par `python init_db.py` pour créer le premier compte Super Admin.
# OBLIGATOIRE si APP_ENV=production : le script refuse de démarrer sans.
# Générer un mot de passe solide, ex :
#   python -c "import secrets; print(secrets.token_urlsafe(24))"
SUPER_ADMIN_EMAIL="admin@sysdent.pro"
SUPER_ADMIN_PASSWORD="CHANGE_THIS_GENERATE_A_STRONG_PASSWORD"

# =============================================================================
# PLATEFORME (backoffice éditeur) — base DEDICEE `sysdent_platform`
# =============================================================================
# Décision D1 de docs/backoffice/00_ETAT_DES_LIEUX.md : base distincte de la base
# master ET des bases tenants. Un rôle SQL plateforme n'a aucun droit sur les bases
# clients, et aucun secret plateforme n'est atteignable depuis le chemin
# d'authentification de l'application cliente.
PLATFORM_DB_HOST="localhost"
PLATFORM_DB_PORT=5432
PLATFORM_DB_USER="postgres"
PLATFORM_DB_PASSWORD="postgres_password"
PLATFORM_DB_NAME="sysdent_platform"
PLATFORM_DB_ECHO=false
PLATFORM_DB_POOL_SIZE=5
PLATFORM_DB_MAX_OVERFLOW=10

# OBLIGATOIRE en production (le démarrage échoue si vide hors développement).
# Générer avec : python -c "import secrets; print(secrets.token_urlsafe(64))"
# Si laissée vide en développement, une clé DISTINCTE est dérivée de SECRET_KEY.
PLATFORM_SECRET_KEY=""
# Clé Fernet dédiée au chiffrement des secrets plateforme stockés en base
# (secret TOTP, jetons de vérification / invitation en attente).
# Générer avec : python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
PLATFORM_SECRET_ENCRYPTION_KEY=""

# Durées (plus courtes que le client : décision D4)
PLATFORM_ACCESS_TOKEN_EXPIRE_MINUTES=10
PLATFORM_REFRESH_TOKEN_EXPIRE_HOURS=8
PLATFORM_SUPPORT_TOKEN_EXPIRE_MINUTES=30

# 2FA TOTP obligatoire
PLATFORM_2FA_ISSUER="SysDent Pro Plateforme"

# Politique de mot de passe & verrouillage
PLATFORM_PASSWORD_MIN_LENGTH=12
PLATFORM_MAX_FAILED_LOGINS=5
PLATFORM_LOCKOUT_MINUTES=15
# Liste blanche d'IP de la console plateforme (vide = aucune restriction).
# Formats acceptés : "10.0.0.5", "10.0.0.0/8", séparés par des virgules.
PLATFORM_IP_WHITELIST=""

# Onboarding public (Phase F)
ONBOARDING_ENABLED=true
ONBOARDING_ESSAI_DAYS=14
ONBOARDING_ESSAI_EXPIRE_ACTION="suspend"   # suspend | cancel
ONBOARDING_VERIFICATION_TOKEN_MINUTES=60
ONBOARDING_CAPTCHA_MODE="honeypot"          # none | header | honeypot
ONBOARDING_CAPTCHA_HEADER="X-Captcha-Token"
ONBOARDING_CAPTCHA_SECRET=""
