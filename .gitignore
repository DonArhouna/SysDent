# ==============================================================================
# SYSDENT PRO - GLOBAL GITIGNORE
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Environment & Secrets (Crucial pour la sécurité)
# ------------------------------------------------------------------------------
.env
.env.*
*.env
!.env.example
!.env.template

# ------------------------------------------------------------------------------
# 2. Python & Backend
# ------------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
# ⚠️ `lib/` et `lib64/` sont ANCRÉS à la racine (`/lib/`).
# Sans l'ancre, git ignore TOUT dossier nommé `lib` à n'importe quelle
# profondeur — y compris `Frontend/src/lib/`, qui contient le client HTTP
# (`api.ts`), le formatage, la navigation et les utilitaires. Conséquence : le
# dépôt ne contenait aucune couche de communication frontend, et un `git clone`
# produisait une application qui ne compile pas (`Cannot find module
# '@/lib/api'`). Les environnements virtuels restent couverts par `.venv/`,
# `venv/`, `env/`.
/lib/
/lib64/

# Garantie explicite : le dossier `lib` du frontend est du code source.
!/Frontend/src/lib/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Environnements virtuels
.venv
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/

